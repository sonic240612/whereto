# Health works without a database. The frontend currently uses browser storage.
PORT=3001

# Database APIs are off unless explicitly enabled AND given a secret of 32+ characters.
# This is an administrator API, not end-user authentication. Never use VITE_ for this secret.
ENABLE_VISIT_API=false
SERVER_API_TOKEN=

# Exact comma-separated browser origins. Empty means no cross-origin browser access.
CORS_ORIGINS=http://localhost:5173

# Required only when enabling database APIs. Do not commit production credentials.
DATABASE_URL="postgresql://user:password@localhost:5432/whereto"
