{
  "name": "whereto-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "build": "prisma generate && tsc",
    "test": "tsx --test tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "cors": "^2.8.6",
    "express": "^4.22.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/node": "^26.0.1",
    "prisma": "^6.19.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "qs": "6.16.0",
    "proxy-addr": "2.0.8",
    "body-parser": "1.20.6",
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    }
  }
}
