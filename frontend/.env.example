# Kakao mode: one JavaScript key switches BOTH the map and place search to Kakao.
# Enable Kakao Map API and register JavaScript SDK domains in Kakao Developers.
# Local domains: http://localhost:5180 and http://127.0.0.1:5180
# Add :5173 domains if using Vite's default port, plus your actual production domain.
# Use a JavaScript key, never a REST API key or Admin key.
# VITE_ values are public in the browser; restrict this key to your service domains.
# Leave empty for the existing OpenFreeMap + Photon development preview.
VITE_KAKAO_MAP_APP_KEY=

# Preview-only overrides below are used when VITE_KAKAO_MAP_APP_KEY is empty.
# With a Kakao key, SDK/search failures show an error instead of silently falling back.
VITE_GEOCODER_URL=https://photon.komoot.io/
# Default preview map: OpenFreeMap Bright, with Korean-first labels.
# VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/bright
# Set VITE_MAP_ATTRIBUTION to your custom provider's required attribution.
# Optional raster-only preview mode (takes priority over VITE_MAP_STYLE_URL):
# VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
